<Project>
  <PropertyGroup>
    <RedBoltIKEnabled Condition="$([System.String]::Copy('$(_RedBoltEnableModulesList)').Contains(',all,')) or $([System.String]::Copy('$(_RedBoltEnableModulesList)').Contains(',ik,'))">true</RedBoltIKEnabled>
    <RedBoltIKEnabled Condition="'$(RedBoltIKEnabled)' == '' and !$([System.String]::Copy('$(_RedBoltDisableModulesList)').Contains(',all,')) and !$([System.String]::Copy('$(_RedBoltDisableModulesList)').Contains(',ik,'))">true</RedBoltIKEnabled>
    <RedBoltIKEnabled Condition="'$(RedBoltIKEnabled)' == ''">false</RedBoltIKEnabled>
  </PropertyGroup>
</Project>
